# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Firebase config — the android/app/ copy was already ignored above; this is
# the repo-root copy app.json's googleServicesFile points the build at. Keep
# it on disk locally (the build needs it), just out of git. Also restrict the
# Android API key it contains in the GCP console — see Mobile/README.md.
/google-services.json

# Play Console service account key (eas.json submit.production.android),
# downloaded from Google Cloud console — never commit it.
/play-service-account.json

# graphify local knowledge graph (machine-specific paths + volatile state)
.graphify/

# build logs
build.log
*.keystore

# Planning docs and business decisions: keep them on disk, out of the public repo.
/plans/
/docs/*-plan.md
/docs/play-store.md
scripts/widget-previews/.out/
